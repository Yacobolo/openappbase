package components

import (
	"fmt"
	"github.com/starfederation/datastar-go/datastar"
)

// AdminBreadcrumb displays the breadcrumb navigation for the admin section
templ AdminBreadcrumb() {
	<div class="breadcrumbs text-sm mb-6">
		<ul>
			<li><a href="/" class="text-primary">Home</a></li>
			<li>Admin</li>
		</ul>
	</div>
}

// AdminTabs displays the tabbed interface for admin sections
templ AdminTabs() {
	<div class="card bg-base-100 shadow-xl">
		<div class="card-body p-0">
			<div role="tablist" class="tabs tabs-bordered">
				<input type="radio" name="admin_tabs" role="tab" class="tab" aria-label="Connections" checked/>
				<div
					role="tabpanel"
					class="tab-content p-6"
					id="connections-tab-panel"
				>
					<div
						id="connections-tab-content"
						data-init={ datastar.GetSSE("/api/admin/connections") }
					></div>
				</div>
				// Future tabs can be added here
				// <input type="radio" name="admin_tabs" role="tab" class="tab" aria-label="Users"/>
				// <div role="tabpanel" class="tab-content p-6">...</div>
			</div>
		</div>
	</div>
}

// ConnectionsTabContent displays the connections management interface
templ ConnectionsTabContent(connections []Connection) {
	<div id="connections-tab-content">
		<div class="flex justify-between items-center mb-6">
			<div>
				<h2 class="text-2xl font-bold">Database Connections</h2>
				<p class="text-base-content/60 text-sm mt-1">Manage your PostgreSQL database connections</p>
			</div>
			<button class="btn btn-primary" onclick="add_connection_modal.showModal()">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
					<path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd"></path>
				</svg>
				Add Connection
			</button>
		</div>
		@ConnectionsList(connections)
		@AddConnectionModal()
	</div>
}

// Connection represents a database connection (for hardcoded data)
type Connection struct {
	ID          int64
	Name        string
	Host        string
	Port        int64
	Database    string
	Username    string
	SSLMode     string
	IsActive    bool
	Environment string
	UpdatedAt   string
}

// ConnectionsList displays the list of database connections
templ ConnectionsList(connections []Connection) {
	if len(connections) == 0 {
		<div class="text-center py-12">
			<div class="avatar mb-4">
				<div class="w-24 rounded-lg bg-[#336791] p-4 opacity-20">
					<img src="/static/assets/postgres-logo.svg" alt="PostgreSQL"/>
				</div>
			</div>
			<h3 class="text-xl font-semibold mb-2">No Connections Yet</h3>
			<p class="text-base-content/60 mb-4">Get started by adding your first PostgreSQL connection</p>
			<button class="btn btn-primary" onclick="add_connection_modal.showModal()">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
					<path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd"></path>
				</svg>
				Add Connection
			</button>
		</div>
	} else {
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
			for _, conn := range connections {
				@ConnectionCard(conn)
			}
		</div>
	}
}

// ConnectionCard displays a single connection card
templ ConnectionCard(conn Connection) {
	<div class={ "card bg-base-100 border-2 hover:shadow-lg transition-shadow", templ.KV("border-blue-200 bg-blue-50/30", conn.IsActive), templ.KV("border-gray-200 bg-gray-50", !conn.IsActive) }>
		<div class="card-body p-5">
			// Header with icon and name
			<div class="flex items-start justify-between mb-3">
				<div class="flex items-center gap-3">
					<div class="avatar">
						<div class="w-12 rounded-lg bg-[#336791] p-2">
							<img src="/static/assets/postgres-logo.svg" alt="PostgreSQL"/>
						</div>
					</div>
					<div>
						<h3 class="font-bold text-lg">{ conn.Name }</h3>
						@EnvironmentBadge(conn.Environment)
					</div>
				</div>
				@StatusBadge(conn.IsActive)
			</div>
			// Connection details
			<div class="space-y-2 text-sm">
				<div class="flex items-center gap-2 text-base-content/70">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path>
					</svg>
					<span class="font-mono">{ conn.Host }:{ templ.EscapeString(formatPort(conn.Port)) }</span>
				</div>
				<div class="flex items-center gap-2 text-base-content/70">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"></path>
					</svg>
					<span class="font-mono">{ conn.Database }</span>
				</div>
				<div class="flex items-center gap-2 text-base-content/70">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
					</svg>
					<span>{ conn.Username }</span>
				</div>
				<div class="flex items-center gap-2 text-base-content/70">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
					</svg>
					<span>SSL: { conn.SSLMode }</span>
				</div>
			</div>
			// Footer with timestamp and actions
			<div class="divider my-3"></div>
			<div class="flex items-center justify-between">
				<span class="text-xs text-base-content/50">Updated { conn.UpdatedAt }</span>
			</div>
			<div class="flex gap-2 mt-2">
				<button
					type="button"
					class="btn btn-sm btn-outline flex-1"
					data-on:click={ datastar.PostSSE("/api/admin/connections/%d/test", conn.ID) }
				>
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
					</svg>
					Test
				</button>
				<button type="button" class="btn btn-sm btn-outline flex-1">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
					</svg>
					Edit
				</button>
				<button
					type="button"
					class="btn btn-sm btn-outline btn-error"
					data-on:click={ datastar.DeleteSSE("/api/admin/connections/%d", conn.ID) }
				>
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
					</svg>
				</button>
			</div>
		</div>
	</div>
}

// StatusBadge displays the connection status
templ StatusBadge(isActive bool) {
	if isActive {
		<div class="badge badge-success gap-2">
			<div class="w-2 h-2 rounded-full bg-success-content"></div>
			Active
		</div>
	} else {
		<div class="badge badge-ghost gap-2">
			<div class="w-2 h-2 rounded-full bg-base-content/40"></div>
			Inactive
		</div>
	}
}

// EnvironmentBadge displays the environment type
templ EnvironmentBadge(env string) {
	switch env {
		case "production":
			<div class="badge badge-error badge-sm">Production</div>
		case "staging":
			<div class="badge badge-warning badge-sm">Staging</div>
		case "development":
			<div class="badge badge-success badge-sm">Development</div>
		case "testing":
			<div class="badge badge-info badge-sm">Testing</div>
		default:
			<div class="badge badge-outline badge-sm">{ env }</div>
	}
}

// AddConnectionModal displays the modal for adding a new connection
// TODO: signals + data-on:submit to handle form submission w. data-indicator
templ AddConnectionModal() {
	<dialog id="add_connection_modal" class="modal">
		<div class="modal-box max-w-2xl">
			<form method="dialog">
				<button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
			</form>
			<h3 class="font-bold text-lg mb-4">Add Database Connection</h3>
			<form
				class="space-y-4"
				onsubmit="event.preventDefault(); const fd = new FormData(event.target); const data = Object.fromEntries(fd); data.port = parseInt(data.port); fetch('/api/admin/connections', {method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(data)}).then(r => r.ok && add_connection_modal.close())"
			>
				// Basic Information Section
				<div class="form-control">
					<label class="label">
						<span class="label-text font-semibold">Connection Name</span>
						<span class="label-text-alt text-error">*</span>
					</label>
					<input
						type="text"
						name="name"
						placeholder="e.g., Production Database"
						class="input input-bordered"
						required
					/>
				</div>
				<div class="divider text-sm">Connection Details</div>
				<div class="grid grid-cols-2 gap-4">
					<div class="form-control col-span-2">
						<label class="label">
							<span class="label-text font-semibold">Host</span>
							<span class="label-text-alt text-error">*</span>
						</label>
						<input
							type="text"
							name="host"
							placeholder="localhost or prod.company.com"
							class="input input-bordered"
							required
						/>
					</div>
					<div class="form-control">
						<label class="label">
							<span class="label-text font-semibold">Port</span>
							<span class="label-text-alt text-error">*</span>
						</label>
						<input
							type="number"
							name="port"
							placeholder="5432"
							value="5432"
							class="input input-bordered"
							required
						/>
					</div>
					<div class="form-control">
						<label class="label">
							<span class="label-text font-semibold">Database</span>
							<span class="label-text-alt text-error">*</span>
						</label>
						<input
							type="text"
							name="database"
							placeholder="postgres"
							class="input input-bordered"
							required
						/>
					</div>
				</div>
				<div class="divider text-sm">Credentials</div>
				<div class="grid grid-cols-2 gap-4">
					<div class="form-control">
						<label class="label">
							<span class="label-text font-semibold">Username</span>
							<span class="label-text-alt text-error">*</span>
						</label>
						<input
							type="text"
							name="username"
							placeholder="postgres"
							class="input input-bordered"
							required
						/>
					</div>
					<div class="form-control">
						<label class="label">
							<span class="label-text font-semibold">Password</span>
							<span class="label-text-alt text-error">*</span>
						</label>
						<div class="relative">
							<input
								type="password"
								name="password"
								placeholder="••••••••"
								class="input input-bordered w-full pr-10"
								required
							/>
							<button type="button" class="btn btn-ghost btn-sm absolute right-0 top-0 h-full">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
								</svg>
							</button>
						</div>
					</div>
				</div>
				<div class="form-control">
					<label class="label">
						<span class="label-text font-semibold">SSL Mode</span>
					</label>
					<select name="ssl_mode" class="select select-bordered">
						<option value="disable">Disable</option>
						<option value="prefer">Prefer</option>
						<option value="require" selected>Require</option>
						<option value="verify-ca">Verify CA</option>
						<option value="verify-full">Verify Full</option>
					</select>
				</div>
				<div class="form-control">
					<label class="label">
						<span class="label-text font-semibold">Environment (Optional)</span>
					</label>
					<select name="environment" class="select select-bordered">
						<option value="">Select environment...</option>
						<option value="development">Development</option>
						<option value="testing">Testing</option>
						<option value="staging">Staging</option>
						<option value="production">Production</option>
					</select>
				</div>
				<div class="modal-action">
					<button type="button" class="btn btn-outline">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
						</svg>
						Test Connection
					</button>
					<button type="button" class="btn" onclick="add_connection_modal.close()">Cancel</button>
					<button type="submit" class="btn btn-primary">Save Connection</button>
				</div>
			</form>
		</div>
		<form method="dialog" class="modal-backdrop">
			<button>close</button>
		</form>
	</dialog>
}

// Helper function to format port number
func formatPort(port int64) string {
	return fmt.Sprintf("%d", port)
}
