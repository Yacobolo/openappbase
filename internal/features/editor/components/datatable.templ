package components

import "northstar/internal/domain"
import "fmt"

// Column defines the structure for a table header.
type Column struct {
	Title string
	Width string
}

// --- Empty Table View Component ---
templ EmptyTableView() {
	<div id="table-container">
		<div class="empty-state">
			<svg fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path>
			</svg>
			<h3>No table selected</h3>
			<p>Enter a table name above to view its data.</p>
		</div>
	</div>
}

// --- Error View Component ---
templ ErrorView(message string) {
	<div class="error-message">
		<svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
			<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd"></path>
		</svg>
		<div>
			<h3>Error loading table</h3>
			<p>{ message }</p>
		</div>
	</div>
}

// --- Header Row Component ---
templ tableHeader(columns []Column) {
	<thead>
		<tr>
			for _, col := range columns {
				<th style={ "width: " + col.Width + ";" }>
					<div class="cell-content">{ col.Title }</div>
				</th>
			}
		</tr>
	</thead>
}

// --- Data Row Component ---
templ tableRow(row []string) {
	<tr>
		for _, cell := range row {
			<td>
				<div class="cell-content">{ cell }</div>
			</td>
		}
	</tr>
}

// --- Main DataTable Component ---
templ DataTable(columns []Column, rows [][]string, pagination interface{}, tableName string) {
	<div id="table-container">
		<table>
			@tableHeader(columns)
			<tbody>
				for _, rowData := range rows {
					@tableRow(rowData)
				}
			</tbody>
		</table>
		// Pagination controls
		@paginationControls(pagination, tableName)
		// --- Styles for the component ---
		<style>
	.cell-content {
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		max-width: 300px;
	}
</style>
	</div>
}

// --- Pagination Controls Component ---
templ paginationControls(pagination interface{}, tableName string) {
	if p, ok := pagination.(domain.PaginationInfo); ok && p.TotalPages > 0 {
		<div class="pagination">
			<div class="pagination-mobile">
				// Mobile pagination
				if p.HasPrevious {
					<button
						data-on:click={ fmt.Sprintf("@post('/api/editor/page/%d')", p.CurrentPage-1) }
					>
						Previous
					</button>
				} else {
					<button disabled>
						Previous
					</button>
				}
				if p.HasNext {
					<button
						data-on:click={ fmt.Sprintf("@post('/api/editor/page/%d')", p.CurrentPage+1) }
					>
						Next
					</button>
				} else {
					<button disabled>
						Next
					</button>
				}
			</div>
			<div class="pagination-desktop">
				<div class="pagination-info">
					<p>
						Showing page
						<strong>{ fmt.Sprintf("%d", p.CurrentPage) }</strong>
						of
						<strong>{ fmt.Sprintf("%d", p.TotalPages) }</strong>
						({ fmt.Sprintf("%d", p.TotalRows) } total rows, { fmt.Sprintf("%d", p.PageSize) } per page)
					</p>
				</div>
				<nav class="pagination-controls" aria-label="Pagination">
					// Previous button
					if p.HasPrevious {
						<button
							class="pagination-prev"
							data-on:click={ fmt.Sprintf("@post('/api/editor/page/%d')", p.CurrentPage-1) }
						>
							<span class="sr-only">Previous</span>
							<svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
								<path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 01-.02 1.06L8.832 10l3.938 3.71a.75.75 0 11-1.04 1.08l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 011.06.02z" clip-rule="evenodd"></path>
							</svg>
						</button>
					} else {
						<button class="pagination-prev" disabled>
							<span class="sr-only">Previous</span>
							<svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
								<path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 01-.02 1.06L8.832 10l3.938 3.71a.75.75 0 11-1.04 1.08l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 011.06.02z" clip-rule="evenodd"></path>
							</svg>
						</button>
					}
					// Current page indicator
					<span class="pagination-current">
						{ fmt.Sprintf("%d", p.CurrentPage) }
					</span>
					// Next button
					if p.HasNext {
						<button
							class="pagination-next"
							data-on:click={ fmt.Sprintf("@post('/api/editor/page/%d')", p.CurrentPage+1) }
						>
							<span class="sr-only">Next</span>
							<svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
								<path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"></path>
							</svg>
						</button>
					} else {
						<button class="pagination-next" disabled>
							<span class="sr-only">Next</span>
							<svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
								<path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"></path>
							</svg>
						</button>
					}
				</nav>
			</div>
		</div>
	}
}

// --- Main DataTable Component ---
templ DataTableV2(columns []Column, rows [][]string) {
	<div id="table-container">
		<table>
			@tableHeader(columns)
			<tbody>
				for _, rowData := range rows {
					@tableRow(rowData)
				}
			</tbody>
		</table>
		// --- Styles for the component ---
		<style>
		.cell-content {
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
			max-width: 300px;
		}
	</style>
	</div>
}
