package components

import "northstar/internal/domain"
import "fmt"

// Column defines the structure for a table header.
type Column struct {
	Title string
	Width string
}

// --- Empty Table View Component ---
templ EmptyTableView() {
	<div id="table-container">
		<div class="text-center py-12 text-gray-500 bg-white rounded-lg border border-gray-200">
			<svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path>
			</svg>
			<h3 class="mt-2 text-sm font-semibold text-gray-900">No table selected</h3>
			<p class="mt-1 text-sm text-gray-500">Enter a table name above to view its data.</p>
		</div>
	</div>
}

// --- Error View Component ---
templ ErrorView(message string) {
	<div class="rounded-lg bg-red-50 border border-red-200 p-4">
		<div class="flex">
			<div class="flex-shrink-0">
				<svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
					<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd"></path>
				</svg>
			</div>
			<div class="ml-3">
				<h3 class="text-sm font-medium text-red-800">Error loading table</h3>
				<div class="mt-2 text-sm text-red-700">
					<p>{ message }</p>
				</div>
			</div>
		</div>
	</div>
}

// --- Header Row Component ---
templ tableHeader(columns []Column) {
	<thead>
		<tr>
			for i, col := range columns {
				// Define the class variable inside a Go block
				{{
					thClass := "bg-gray-100 border-b border-gray-300"
					if i < len(columns)-1 {
						thClass += " border-r"
					}
				}}
				<th style={ "width: " + col.Width + ";" } class={ thClass }>
					<div class="cell-content py-2 px-4 text-left text-sm font-semibold text-gray-700 uppercase">{ col.Title }</div>
				</th>
			}
		</tr>
	</thead>
}

// --- Data Row Component ---
templ tableRow(row []string) {
	<tr class="hover:bg-gray-50">
		for i, cell := range row {
			// Create a Go block to define the class variable
			{{
				tdClass := "border-b border-gray-200"
				if i < len(row)-1 {
					tdClass += " border-r"
				}
			}}
			<td class={ tdClass }>
				<div class="cell-content py-2 px-4 text-gray-800">{ cell }</div>
			</td>
		}
	</tr>
}

// --- Main DataTable Component ---
templ DataTable(columns []Column, rows [][]string, pagination interface{}, tableName string) {
	<div id="table-container">
		<div class="spreadsheet-container border border-gray-300 bg-white rounded-none">
			<div class="header-wrapper overflow-x-hidden">
				<table id="header-table" class="w-full border-collapse">
					@tableHeader(columns)
				</table>
			</div>
			<div class="data-wrapper overflow-auto" style="max-height: 400px; overflow-y: scroll;">
				<table id="data-table" class="table-fixed w-full border-collapse">
					<tbody>
						for _, rowData := range rows {
							@tableRow(rowData)
						}
					</tbody>
				</table>
			</div>
		</div>
		// Pagination controls
		@paginationControls(pagination, tableName)
		// --- Styles and Scripts for the component ---
		<style>
	.cell-content {
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
</style>
		<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
		<script src="https://cdn.jsdelivr.net/npm/colresizable@1.6.0/colResizable-1.6.min.js"></script>
		<script>
	// This script is scoped to the DataTable component
	$(document).ready(function() {
		const headerTable = $("#header-table");
		const dataTable = $("#data-table");
		const headerWrapper = $('.header-wrapper');
		const dataWrapper = $('.data-wrapper');

		if ($.fn.colResizable && headerTable.length) {
			headerTable.colResizable({
				liveDrag: true,
				resizeMode: 'overflow',
				onDrag: syncColumnWidths,
				onResize: syncColumnWidths
			});
		}

		dataWrapper.on('scroll', function() {
			headerWrapper.scrollLeft($(this).scrollLeft());
		});

		function syncColumnWidths() {
			if (!headerTable.length || !dataTable.length) return;

			dataTable.width(headerTable.outerWidth());
			const headerCols = headerTable.find("th");
			const dataCols = dataTable.find("tbody tr:first-child td");

			if (headerCols.length === dataCols.length) {
				headerCols.each(function(index) {
					const colWidth = $(this).outerWidth();
					dataCols.eq(index).outerWidth(colWidth);
				});
			}
		}
		
		syncColumnWidths();
	});
</script>
	</div>
}

// --- Pagination Controls Component ---
templ paginationControls(pagination interface{}, tableName string) {
	if p, ok := pagination.(domain.PaginationInfo); ok && p.TotalPages > 0 {
		<div class="mt-4 flex items-center justify-between border-t border-gray-200 bg-white px-4 py-3 sm:px-6">
			<div class="flex flex-1 justify-between sm:hidden">
				// Mobile pagination
				if p.HasPrevious {
					<button
						class="relative inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50"
						data-on-click={ fmt.Sprintf("@post('/api/editor/page/%d')", p.CurrentPage-1) }
					>
						Previous
					</button>
				} else {
					<button
						class="relative inline-flex items-center rounded-md border border-gray-300 bg-gray-100 px-4 py-2 text-sm font-medium text-gray-400 cursor-not-allowed"
						disabled
					>
						Previous
					</button>
				}
				if p.HasNext {
					<button
						class="relative ml-3 inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50"
						data-on-click={ fmt.Sprintf("@post('/api/editor/page/%d')", p.CurrentPage+1) }
					>
						Next
					</button>
				} else {
					<button
						class="relative ml-3 inline-flex items-center rounded-md border border-gray-300 bg-gray-100 px-4 py-2 text-sm font-medium text-gray-400 cursor-not-allowed"
						disabled
					>
						Next
					</button>
				}
			</div>
			<div class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between">
				<div>
					<p class="text-sm text-gray-700">
						Showing page
						<span class="font-medium">{ fmt.Sprintf("%d", p.CurrentPage) }</span>
						of
						<span class="font-medium">{ fmt.Sprintf("%d", p.TotalPages) }</span>
						({ fmt.Sprintf("%d", p.TotalRows) } total rows, { fmt.Sprintf("%d", p.PageSize) } per page)
					</p>
				</div>
				<div>
					<nav class="isolate inline-flex -space-x-px rounded-md shadow-sm" aria-label="Pagination">
						// Previous button
						if p.HasPrevious {
							<button
								class="relative inline-flex items-center rounded-l-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0"
								data-on-click={ fmt.Sprintf("@post('/api/editor/page/%d')", p.CurrentPage-1) }
							>
								<span class="sr-only">Previous</span>
								<svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
									<path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 01-.02 1.06L8.832 10l3.938 3.71a.75.75 0 11-1.04 1.08l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 011.06.02z" clip-rule="evenodd"></path>
								</svg>
							</button>
						} else {
							<button
								class="relative inline-flex items-center rounded-l-md px-2 py-2 text-gray-300 ring-1 ring-inset ring-gray-300 bg-gray-100 cursor-not-allowed"
								disabled
							>
								<span class="sr-only">Previous</span>
								<svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
									<path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 01-.02 1.06L8.832 10l3.938 3.71a.75.75 0 11-1.04 1.08l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 011.06.02z" clip-rule="evenodd"></path>
								</svg>
							</button>
						}
						// Current page indicator
						<span class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 bg-white">
							{ fmt.Sprintf("%d", p.CurrentPage) }
						</span>
						// Next button
						if p.HasNext {
							<button
								class="relative inline-flex items-center rounded-r-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0"
								data-on-click={ fmt.Sprintf("@post('/api/editor/page/%d')", p.CurrentPage+1) }
							>
								<span class="sr-only">Next</span>
								<svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
									<path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"></path>
								</svg>
							</button>
						} else {
							<button
								class="relative inline-flex items-center rounded-r-md px-2 py-2 text-gray-300 ring-1 ring-inset ring-gray-300 bg-gray-100 cursor-not-allowed"
								disabled
							>
								<span class="sr-only">Next</span>
								<svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
									<path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"></path>
								</svg>
							</button>
						}
					</nav>
				</div>
			</div>
		</div>
	}
}

// --- Main DataTable Component ---
templ DataTableV2(columns []Column, rows [][]string) {
	<div id="table-container">
		<div class="spreadsheet-container border border-gray-300 bg-white rounded-none">
			<div class="header-wrapper overflow-x-hidden">
				<table id="header-table" class="w-full border-collapse">
					@tableHeader(columns)
				</table>
			</div>
			<div class="data-wrapper overflow-auto" style="max-height: 400px; overflow-y: scroll;">
				<table id="data-table" class="table-fixed w-full border-collapse">
					<tbody>
						for _, rowData := range rows {
							@tableRow(rowData)
						}
					</tbody>
				</table>
			</div>
		</div>
		// --- Styles and Scripts for the component ---
		<style>
		.cell-content {
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
		}
	</style>
		<script>
		// This script is scoped to the DataTable component
		$(document).ready(function() {
			const headerTable = $("#header-table");
			const dataTable = $("#data-table");
			const headerWrapper = $('.header-wrapper');
			const dataWrapper = $('.data-wrapper');

			if ($.fn.colResizable && headerTable.length) {
				headerTable.colResizable({
					liveDrag: true,
					resizeMode: 'overflow',
					onDrag: syncColumnWidths,
					onResize: syncColumnWidths
				});
			}

			dataWrapper.on('scroll', function() {
				headerWrapper.scrollLeft($(this).scrollLeft());
			});

			function syncColumnWidths() {
				if (!headerTable.length || !dataTable.length) return;

				dataTable.width(headerTable.outerWidth());
				const headerCols = headerTable.find("th");
				const dataCols = dataTable.find("tbody tr:first-child td");

				if (headerCols.length === dataCols.length) {
					headerCols.each(function(index) {
						const colWidth = $(this).outerWidth();
						dataCols.eq(index).outerWidth(colWidth);
					});
				}
			}
			
			syncColumnWidths();
		});
	</script>
	</div>
}
