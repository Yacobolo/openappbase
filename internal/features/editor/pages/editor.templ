package pages

import (
	"github.com/starfederation/datastar-go/datastar"
	"northstar/internal/domain"
	"northstar/internal/features/common/layouts"
	"northstar/internal/features/editor/components"
)

type EditorPageData struct {
	TableName  string
	Columns    []components.Column
	Rows       [][]string
	Pagination domain.PaginationInfo
	Error      string
}

// --- Main Page Component ---
templ EditorPage(data EditorPageData) {
	@layouts.AppShell("Data Table Editor") {
		<div class="container">
			<div id="table-container" data-init={ datastar.GetSSE("/api/editor") }></div>
		</div>
	}
}
