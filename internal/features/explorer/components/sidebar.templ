package components

import (
	"fmt"
	"github.com/starfederation/datastar-go/datastar"
	"northstar/internal/domain"
	"strconv"
)

type TableView struct {
	domain.Table
	IsActive bool // To determine which link is active
}

type SchemaView struct {
	Name   string
	Tables []TableView
}

// SchemaItem is a collapsible component for a single schema and its tables.
templ SchemaItem(schema SchemaView, isOpen bool) {
	<details open?={ isOpen }>
		<summary>
			@FolderIcon()
			{ schema.Name }
			<span class="count">{ strconv.Itoa(len(schema.Tables)) }</span>
		</summary>
		<ul>
			for _, table := range schema.Tables {
				<li>
					<a
						class={ templ.KV("active", table.IsActive) }
						data-on:click={ datastar.GetSSE(fmt.Sprintf("/explorer/%s/%s", schema.Name, table.Name)) }
					>
						@TableIcon()
						{ table.Name }
					</a>
				</li>
			}
		</ul>
	</details>
}

// Sidebar is the main sidebar component.
templ Sidebar(schemas []SchemaView) {
	<aside>
		<header>
			<h1>Unity Explorer</h1>
			<p>Postgres Edition</p>
		</header>
		<div>
			<input type="text" id="catalog-search" placeholder="Search tables..."/>
		</div>
		<nav id="catalog-nav">
			for _, schema := range schemas {
				{{
	var isOpen bool
	for _, table := range schema.Tables {
		if table.IsActive {
			isOpen = true
			break
		}
	}
				}}
				@SchemaItem(schema, isOpen)
			}
		</nav>
		<footer>
			<span class="badge badge-outline">Connected</span>
		</footer>
	</aside>
}
