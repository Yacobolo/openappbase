package components

import "fmt"
import "northstar/internal/domain"

// --- Data Structures ---

type BreadcrumbItem struct {
	Name string
	Href string // Optional link for the breadcrumb
}

type TableData struct {
	Headers []string
	Rows    [][]any // Using []any (or []interface{}) to allow for mixed data types in rows
}

type MainContentData struct {
	Breadcrumbs  []BreadcrumbItem
	TableData    TableData
	Columns      []domain.Column
	TableDetails domain.Table
}

// --- Components ---
templ Breadcrumbs(items []BreadcrumbItem) {
	<div id="breadcrumbs" class="breadcrumb">
		for i, item := range items {
			if i == 0 && item.Href != "" {
				// First item is typically a link
				<a href={ templ.URL(item.Href) }>{ item.Name }</a>
			} else {
				// Subsequent items are just text
				<span>{ item.Name }</span>
			}
		}
	</div>
}

templ DataView(data TableData) {
	<div role="tabpanel">
		if len(data.Rows) == 0 {
			<div class="empty-state">No data to display.</div>
		} else {
			<table>
				<thead>
					<tr>
						for _, header := range data.Headers {
							<th>{ header }</th>
						}
					</tr>
				</thead>
				<tbody>
					for _, row := range data.Rows {
						<tr>
							for i, cell := range row {
								<td>
									// Special handling for a "status" column to render a badge
									if data.Headers[i] == "status" {
										switch fmt.Sprintf("%v", cell) {
											case "active":
												<span class="badge badge-success">active</span>
											case "inactive":
												<span class="badge">inactive</span>
											default:
												<span class="badge badge-outline">{ fmt.Sprintf("%v", cell) }</span>
										}
									} else {
										{ fmt.Sprintf("%v", cell) }
									}
								</td>
							}
						</tr>
					}
				</tbody>
			</table>
		}
	</div>
}

templ ColumnsView(columns []domain.Column) {
	<div role="tabpanel">
		<table>
			<thead>
				<tr>
					<th>Column</th>
					<th>Type</th>
					<th>Nullable</th>
					<th>Default</th>
				</tr>
			</thead>
			<tbody>
				for _, col := range columns {
					<tr>
						<td>{ col.Name }</td>
						<td><code>{ col.DataType }</code></td>
						<td>
							if col.IsNullable {
								Yes
							} else {
								No
							}
						</td>
						<td><code>{ col.ColumnDefault }</code></td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

templ DetailsView(details domain.Table) {
	<div role="tabpanel">
		<dl>
			<dt>Table Owner</dt>
			<dd><code>{ details.Owner }</code></dd>
			
			<dt>Row Security</dt>
			<dd>
				if details.RowSecurityEnabled {
					<span class="badge badge-success">Enabled</span>
				} else {
					<span class="badge badge-danger">Disabled</span>
				}
			</dd>
			
			<dt>Estimated Rows</dt>
			<dd><code>{ fmt.Sprintf("%d", details.EstimatedRows) }</code></dd>
		</dl>
	</div>
}

templ MainContent(params MainContentData) {
	<main>
		// Access data through the 'params' variable
		@Breadcrumbs(params.Breadcrumbs)
		<div id="view-container" class="card">
			<div class="tabs">
				<button class="active">Details</button>
				<button>Data</button>
				<button>Columns</button>
			</div>
			<div role="tablist">
				<input type="radio" name="table_tabs" role="tab" aria-label="Details" checked/>
				@DetailsView(params.TableDetails)
				<input type="radio" name="table_tabs" role="tab" aria-label="Data"/>
				@DataView(params.TableData)
				<input type="radio" name="table_tabs" role="tab" aria-label="Columns"/>
				@ColumnsView(params.Columns)
			</div>
		</div>
	</main>
}
