# Environment Configuration Example
# Copy this file to .env and customize as needed
# Note: In dev mode, most of these have sensible defaults

# REQUIRED: Encryption key for sensitive data (must be exactly 32 bytes)
# This key is used to encrypt database connection strings and other sensitive data
# Generate a secure key for production: openssl rand -hex 16
ENCRYPTION_KEY=01234567890123456789012345678901

# Optional: Server configuration
# HOST=0.0.0.0
# PORT=8080

# Optional: Session secret for cookie signing
# SESSION_SECRET=session-secret

# Optional: Log level (DEBUG, INFO, WARN, ERROR)
# LOG_LEVEL=INFO

# Optional: SQLite database path override
# SQLITE_DB_PATH=data/app.db
